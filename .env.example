# Copy this file to ".env" and fill in your own keys.
# NEVER commit the real ".env" file to git.

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get a free key at https://smith.langchain.com/settings
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=scholarcite-rag

# Optional: only needed if you use MLflow with a remote tracking server.
# Leave blank to use local file-based tracking (./mlruns).
MLFLOW_TRACKING_URI=
